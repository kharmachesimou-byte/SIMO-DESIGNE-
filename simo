    <script>
        // ====== À MODIFIER ICI SI BESOIN ======
        // Numéro au format international, sans + ni espaces (Maroc : 212 + numéro sans le 0)
        var NUMERO_WHATSAPP = "212702263856";
        // Message pré-rempli qui s'affiche dans WhatsApp
        var MESSAGE = "Bonjour Simo, j'ai un projet et je souhaite en discuter.";
        // =====================================

        // Menu mobile
        var bouton = document.getElementById("menu-toggle");
        var menu = document.getElementById("menu");

        bouton.addEventListener("click", function () {
            var ouvert = menu.classList.toggle("ouvert");
            bouton.setAttribute("aria-expanded", ouvert);
        });

        menu.addEventListener("click", function (e) {
            if (e.target.tagName === "A") {
                menu.classList.remove("ouvert");
                bouton.setAttribute("aria-expanded", "false");
            }
        });

        // QR code WhatsApp (même lien que le bouton WhatsApp)
        var lienWhatsApp = "https://wa.me/" + NUMERO_WHATSAPP + "?text=" + encodeURIComponent(MESSAGE);

        try {
            new QRCode(document.getElementById("qrcode"), {
                text: lienWhatsApp,
                width: 160,
                height: 160,
                colorDark: "#111111",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.M
            });
        } catch (e) {
            document.getElementById("qrcode").textContent = "QR code indisponible.";
        }

        // Téléchargement du QR code en image PNG
        document.getElementById("btn-telecharger").addEventListener("click", function () {
            var canvas = document.querySelector("#qrcode canvas");
            if (!canvas) { return; }
            var a = document.createElement("a");
            a.href = canvas.toDataURL("image/png");
            a.download = "qr-whatsapp-simo.png";
            a.click();
        });

        // Année automatique dans le pied de page
        document.getElementById("annee").textContent = new Date().getFullYear();
    </script>

